[Unit]
Description=Private portfolio holdings state API
After=network.target

[Service]
Type=simple
User=portfolio-state
Group=portfolio-state
SupplementaryGroups=www-data
Environment=PORTFOLIO_STATE_FILE=/var/lib/portfolio-news-dashboard/holdings.json
Environment=XAI_USAGE_FILE=/var/lib/portfolio-news-dashboard/xai-usage.json
Environment=XAI_DIGEST_FILE=/var/lib/portfolio-news-dashboard/x-digest.json
Environment=XAI_MODEL=grok-4.3
Environment=XAI_DAILY_REQUEST_LIMIT=40
Environment=PORTFOLIO_AUTH_FILE=/etc/nginx/portfolio-dashboard.htpasswd
Environment=PORTFOLIO_SESSION_SECRET_FILE=/var/lib/portfolio-news-dashboard/session-secret
EnvironmentFile=/home/ubuntu/.config/daily-report/secrets.env
ExecStart=/usr/local/bin/portfolio-state-api
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portfolio-news-dashboard

[Install]
WantedBy=multi-user.target
